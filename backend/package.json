{
  "name": "@radio/backend",
  "private": true,
  "packageManager": "npm@10.8.0",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "lint": "eslint src",
    "migration:generate": "npm run build && typeorm migration:generate -d dist/database/data-source.js",
    "migration:run": "npm run build && typeorm migration:run -d dist/database/data-source.js",
    "migration:revert": "npm run build && typeorm migration:revert -d dist/database/data-source.js",
    "migration:show": "npm run build && typeorm migration:show -d dist/database/data-source.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.18",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.18",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.18",
    "@nestjs/typeorm": "^11.0.2",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^17.4.1",
    "file-type": "^21.3.4",
    "music-metadata": "^11.16.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@nestjs/cli": "^11.0.17",
    "@nestjs/schematics": "^11.0.10",
    "@types/bcrypt": "^6.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.10",
    "@types/passport-jwt": "^4.0.1",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^10.1.8",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.4.0"
  }
}
